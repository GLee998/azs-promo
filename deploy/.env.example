# Скопировать в deploy/.env и заполнить: cp .env.example .env
# Файл .env в git не попадает: в нём пароль базы.

# Пароль Postgres: openssl rand -hex 24
POSTGRES_PASSWORD=

# Адреса сайтов. Для каждого нужна A-запись DNS на IP сервера.
CLIENT_HOST=karavan.example.kg
KASSA_HOST=kassa.karavan.example.kg
ADMIN_HOST=admin.karavan.example.kg

# Тестовый стенд (docker compose --profile test up -d). Пусто — стенд не нужен.
TEST_CLIENT_HOST=
TEST_KASSA_HOST=
TEST_ADMIN_HOST=
# Лимиты тестового стенда. На время нагрузочного теста (backend/loadtest.py) поставить 1000000,
# потом вернуть пустыми. Боевые лимиты RL_* ниже при этом не меняются.
TEST_RL_REG_IP=
TEST_RL_REG_PHONE=
TEST_RL_LOGIN_IP=

# Правила акции
SMS_REQUIRED=false
DRAW_RESET_ALLOWED=false
DRAW_PRIZES=8
WAITING_TTL_HOURS=3

# Производительность: 2 воркера на 2 vCPU, у каждого пул до DB_POOL_SIZE + 5 соединений с базой.
WEB_CONCURRENCY=2
DB_POOL_SIZE=10

# Вход сотрудников и лимиты частоты
SESSION_TTL_HOURS=14
RL_REG_IP=60
RL_REG_PHONE=5
RL_LOGIN_IP=10

# Бэкапы (deploy/backup.sh). На сервере хранятся KEEP_LOCAL последних дампов, история — вне сервера.
# RCLONE_REMOTE — куда копировать, например s3:karavan-backups (срок хранения задать правилом хранилища).
BACKUP_DIR=/var/backups/karavan
KEEP_LOCAL=8
RCLONE_REMOTE=

# Порты Caddy. На сервере 80 и 443, для локальной проверки можно 8080 и 8443.
HTTP_PORT=80
HTTPS_PORT=443
